        },
        "type": "StructuredText"
      },
      "image": {
        "config": {
          "label": "Image"
        },
        "type": "Image"
      },
      "category": {
        "config": {
          "label": "Category",
          "placeholder": "Production Update"
        },
        "type": "Text"
      },
      "date": {
        "config": {
          "label": "Date"
        },
        "type": "Date"
      },
      "link": {
        "config": {
          "allowTargetBlank": true,
          "label": "External link",
          "select": "web"
        },
        "type": "Link"
      }
    }
  },
  "label": "News Article",
